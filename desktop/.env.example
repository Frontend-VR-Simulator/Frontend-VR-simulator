API_URL=http://localhost:8000/api/v1/user
# Optional absolute file path read by the packaged Unreal application.
# VR_SESSION_PATH=C:\Users\Public\VRSimulation\session.json
# Optional absolute path passed to the VR application as -ResultsPath. It writes one
# results-<sessionId>.json per session into this file's folder, which the launcher watches.
# VR_RESULTS_PATH=C:\VRPharma\results\results.json
# Results API; defaults to API_URL with /user replaced by /vr.
# VR_API_URL=http://localhost:8000/api/v1/vr
